{
  "name": "pawnshake",
  "version": "0.1.1",
  "description": "Pawnshake protocol: signed peer-to-peer chess games (TypeScript implementation)",
  "keywords": [
    "chess",
    "protocol",
    "ed25519",
    "zip215",
    "p2p",
    "signatures",
    "pawnshake"
  ],
  "homepage": "https://pawntown.github.io/pawnshake/",
  "bugs": {
    "url": "https://github.com/PawnTown/pawnshake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PawnTown/pawnshake.git",
    "directory": "js"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build && npm run coverage"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
